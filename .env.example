# Projeto Supabase. Ambas ficam apenas no servidor: o cliente nunca fala com o Supabase
# direto, então não existe variável NEXT_PUBLIC_ aqui. Ver ADR 0001, decisão 2.
SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=

# NUNCA use a service_role key nesta aplicação: ela ignora o RLS.

# Origem canônica do site, usada no retorno do login. Precisa estar na lista de Redirect URLs
# do Supabase. Em desenvolvimento: http://localhost:3000
SITE_URL=

# Opcional. Quando definido, /api/health só responde com este segredo no cabeçalho
# Authorization, que é o que a tarefa agendada da Vercel envia.
CRON_SECRET=
